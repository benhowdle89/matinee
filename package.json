{
  "name": "matinee",
  "version": "0.1.2",
  "description": "Staged cursor performances for React. A programmable ghost cursor that moves, clicks, types and scrolls like a human, then exports itself as an animated SVG.",
  "keywords": [
    "react",
    "cursor",
    "agent",
    "demo",
    "animation",
    "svg",
    "screencast"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run verify",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "hero": "npm run build && node scripts/make-hero.mjs && cp assets/hero.svg demo/public/hero.svg",
    "docs:assets": "npm run build && node scripts/make-docs-assets.mjs && node scripts/make-export-examples.mjs",
    "llms": "npm run build && node scripts/make-llms.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Ben Howdle <benhowdle89@gmail.com>",
  "homepage": "https://matinee.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benhowdle89/matinee.git"
  },
  "bugs": {
    "url": "https://github.com/benhowdle89/matinee/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.21.5": true
  }
}
